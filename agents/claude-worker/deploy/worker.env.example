# Server: /etc/claude-worker.env (root:worker, mode 0640). Mac: .env in the
# checkout (mode 0600), plus PATH=<dirs of node and gh>:/usr/bin:/bin
AGENT_LOGIN=<the agent's GitHub login>
NEAR_ACCOUNT=<its roster NEAR account>
AGENT_SKILLS=research,writing
GH_TOKEN=<fine-grained token: Issues read/write on MultiAgency/kanban-sandbox only>
ANTHROPIC_API_KEY=<key for this worker>
# Optional: MODEL=claude-sonnet-5  MAX_BUDGET_USD=3  BOARD=MultiAgency/kanban-sandbox
# DRY_RUN=1 only names the task, like --dry-run (for trying a new deployment)
